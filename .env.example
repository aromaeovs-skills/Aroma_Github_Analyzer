# Add at least one AI provider key if AI-powered reviews are enabled.
GEMINI_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

# MongoDB is required for persistent analysis history and reliable monthly quotas.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=github_analyzer

# GitHub OAuth App credentials and callback URLs.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Used to sign 60-minute API access tokens issued after GitHub login.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=
AUTH_TOKEN_ISSUER=github-analyzer
AUTH_TOKEN_AUDIENCE=github-analyzer-api

# Razorpay subscription configuration. Create the INR monthly plan in Razorpay
# Dashboard and set its plan ID here; never accept plan IDs or amounts from clients.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay requires a finite cycle count (1-100); decide this before checkout.
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=

# Comma-separated frontend origins; do not use "*" in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
